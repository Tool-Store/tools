# MCP server
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO

# Requests allowed per site per day (resets at 00:00 UTC)
DAILY_REQUEST_LIMIT=50
# Where the daily counts are saved; keep it on the persisted volume
USAGE_FILE=~/.agent-reach/social-agent-usage.json
# Link the user opens to see the browser and log in
VIEWER_URL=http://localhost:6080/vnc.html

# Encrypts saved site logins; required. Create one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOGIN_ENCRYPTION_KEY=
# Where encrypted logins are saved; keep it on the persisted volume
LOGIN_STORE_DIR=~/.agent-reach/logins
# Browser sessions that may run at the same time (each uses roughly 150-300 MB)
MAX_BROWSER_SESSIONS=3
# Local runs only: the user the server acts for when no Toolstore user is on the request
TOOLSTORE_USER_ID=
