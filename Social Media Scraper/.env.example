# Optional Jina Reader API key for higher rate limits (https://jina.ai/reader).
# In Tool Store this is supplied per user through the activation form.
JINA_API_KEY=

# Apify API token for Instagram, Facebook, LinkedIn and X (https://console.apify.com/settings/integrations).
# Tool Store-level key set in the server environment, not a per-user activation field.
APIFY_API_TOKEN=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
