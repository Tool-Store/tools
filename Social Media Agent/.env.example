# MCP server
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO
# Host names the server answers to, comma-separated ("host:*" = any port). On Toolstore use the tool's
# cluster host, or * when the MCP port is reachable only inside the cluster.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Requests allowed per user per site per day (resets at 00:00 UTC)
DAILY_REQUEST_LIMIT=50
# Instagram flags automated use faster, so it has its own lower limit (1 per call: each call loads one profile page)
INSTAGRAM_DAILY_REQUEST_LIMIT=20
# Link the user opens to see the browser and log in
VIEWER_URL=http://localhost:6080/vnc.html

# Encrypts saved site logins; required. Create one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOGIN_ENCRYPTION_KEY=
# Browser sessions that may run at the same time (each uses roughly 150-300 MB)
MAX_BROWSER_SESSIONS=3

# Local runs only (without Toolstore):
# where saved logins and daily counts are kept; keep it on the persisted volume
USER_DATA_DIR=~/.agent-reach/user-data
# the user the server acts for when no Toolstore user is on the request
SOCIAL_AGENT_LOCAL_USER_ID=

# On Toolstore, TOOLSTORE_API_BASE, TOOLSTORE_DEV_SLUG and TOOLSTORE_TOOL_SLUG are set by Toolstore at publish
# time; logins and counts are then kept in the user's Toolstore data instead of USER_DATA_DIR.
